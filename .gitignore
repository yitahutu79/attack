# Model checkpoints and large binary artifacts
*.pt
*.pth
*.ckpt
*.bin
*.npy
*.npy.gz

# Keep curated result tables/docs, but ignore notebook noise
.ipynb_checkpoints/

# Editor / IDE
.vscode/
.idea/

# Local writeups / briefing slides (not for artifact upload)
presentation_week_update_*.html
*_progress_briefing_*.html
*_reading_priority*.md
UPLOAD_INVENTORY_ATTACK.md

# Keep repo artifact-focused: ignore secondary docs/notes inside outputs/modules
results/**/*.md
baselines/README.md
models/README.md
pipelines/README.md
dataset/**/README.md
